# Copie este arquivo para ".env" (ou "chave.env"), na mesma pasta do server.py, e preencha.
# Não compartilhe esse arquivo com ninguém.
PROVIDER=anthropic
ANTHROPIC_API_KEY=cole_sua_chave_aqui

# Para usar a OpenAI, troque por:
# PROVIDER=openai
# OPENAI_API_KEY=cole_sua_chave_aqui

# Opcional: escolher outro modelo
# MODEL=claude-sonnet-5-5
